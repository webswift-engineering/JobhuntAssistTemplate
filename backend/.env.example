# --- Server ---
PORT=8787
# Interface to bind. Default 127.0.0.1 (localhost only). To reach the app from your
# iPad / phone / other PC over Tailscale or your LAN, set HOST=0.0.0.0.
HOST=127.0.0.1
# Shared secret required when HOST is not loopback. The server refuses to expose
# itself beyond localhost without this. Generate one with: npm run gen-token
ACCESS_TOKEN=
# Public URL the app is reached at from other devices (Tailscale MagicDNS / IP, or a
# Cloudflare Tunnel domain). Used for Slack deep-links. e.g. http://your-pc.tailnet.ts.net:8787
PUBLIC_URL=
# Send the auth cookie only over HTTPS. Keep 0 for http:// access (Tailscale/LAN); set 1
# only when you front the app with HTTPS (e.g. Cloudflare Tunnel).
COOKIE_SECURE=0
# Comma-separated CORS origins allowed to call the API (dashboard + extension).
# Use '*' for localhost convenience. Lock down if ever exposed beyond 127.0.0.1.
CORS_ORIGINS=*

# --- LLM (DeepSeek, OpenAI-compatible). Optional: if unset, heuristic fallbacks are used. ---
DEEPSEEK_API_KEY=
# deepseek-v4-flash = fast/cheap (scoring, triage); deepseek-v4-pro = higher quality tailoring
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Scheduler ---
# Every hour, Mon–Sat (cron dow 1-6 = Mon–Sat).
POLL_CRON=0 * * * 1-6
TZ=America/New_York
# Auto-start the cron scheduler on boot (set 0 to only allow manual /admin/poll-now).
SCHEDULER_ENABLED=1

# --- Notifications ---
# Relevance score (0..1) at or above which a fresh job triggers a notification.
NOTIFY_THRESHOLD=0.7
# Only show in queue / notify for jobs posted (or first captured) within this window.
FRESHNESS_HOURS=24

# --- Morning / evening browse reminders (LinkedIn, Indeed, career sites) ---
ROUTINE_ENABLED=1
# Mon–Sat 9:00 AM and 6:00 PM in TZ (below)
ROUTINE_CRON=0 9 * * 1-6
ROUTINE_EVENING_CRON=0 18 * * 1-6
# Optional: override search URLs (otherwise set in Dashboard → Profile → Morning Slack links)
# ROUTINE_LINKEDIN_URL=
# ROUTINE_INDEED_URL=

# --- Daily discovery (JSearch + Adzuna) ---
DISCOVERY_ENABLED=1
# Daily at 8:00 AM in TZ (below). Query: software engineer, US + CA, last 24h.
DISCOVERY_CRON=0 8 * * *
DISCOVERY_QUERY=software engineer
DISCOVERY_MAX_DAYS_OLD=1
JSEARCH_DATE_POSTED=today
JSEARCH_COUNTRIES=us,ca
JSEARCH_NUM_PAGES=2
# RapidAPI key for JSearch (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch)
JSEARCH_API_KEY=
# Adzuna (https://developer.adzuna.com/signup)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=us,ca
ADZUNA_MAX_PAGES=2
ADZUNA_RESULTS_PER_PAGE=50

# --- Workday ATS poll ---
# Workday boards are huge; restrict the server-side search to engineering roles so
# we don't ingest/score warehouse/finance/sales postings. Set to "" to pull all.
WORKDAY_SEARCH_TEXT=engineer
WORKDAY_MAX_JOBS=50
WORKDAY_MAX_PAGES=10

# --- Salary floor (optional, off by default) ---
# Drop jobs whose KNOWN salary is below your bar; unknown salary always passes.
# Hybrid/onsite and fully-remote bars, in CAD; USD converts at USD_TO_CAD.
# SALARY_FLOOR_HYBRID_CAD=
# SALARY_FLOOR_REMOTE_CAD=
# USD_TO_CAD=1.37

# --- Resume tailoring (Phase 2–3) ---
# Generated résumés land here (gitignored via backend/data/).
RESUME_DIR=./data/resumes
# Chrome for PDF rendering (puppeteer-core). Override if installed elsewhere.
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Compiled from work-experience/ via: npx tsx src/profile/compileProfile.ts
# MASTER_PROFILE_PATH=./data/master-profile.json

SLACK_WEBHOOK_URL=
# Base URL the notification deep-links point to. The backend now serves the dashboard
# itself, so this defaults to PUBLIC_URL (or http://localhost:PORT). Override if needed.
# DASHBOARD_URL=
