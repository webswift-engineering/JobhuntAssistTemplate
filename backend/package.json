{
  "name": "job-assistant-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Job Hunt Assistant backend — keeps the human on decisions, bot owns the mechanical.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "gen-token": "node -e \"console.log(require('crypto').randomBytes(24).toString('base64url'))\"",
    "create-user": "tsx scripts/create-user.ts",
    "migrate:pg": "tsx scripts/migrate-sqlite-to-pg.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "puppeteer-core": "^25.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/puppeteer-core": "^5.4.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
